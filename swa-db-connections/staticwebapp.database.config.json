{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=sqlserverjaps.database.windows.net,1433;Initial Catalog=GeneralDB;Persist Security Info=False;User ID=appuser;Password=Test_123;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;"
  },
  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/dabapi"
    },
    "host": {
      "mode": "Development",
      "cors": {
        "origins": ["http://localhost:4280"],
        "allow-credentials": false
      }
    },
    "authentication": {
      "provider": "StaticWebApps"
    }
  },
  "entities": {
    "Customer": {
      "source": {
        "object": "dbo.Customer",
        "type": "table"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": ["create", "read", "update", "delete"]
        }
      ]
    }
  }
}
