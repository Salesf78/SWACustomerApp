{
  "name": "customer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dab": "set DAB_AUTH_PROVIDER=None&& dab start -c swa-db-connections/staticwebapp.database.config.json",
